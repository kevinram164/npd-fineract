# Copy → /home/sysadmin/npd-fineract-ecosystem/.env

FINERACT_URL=https://npd-fineract.co/fineract-provider/api/v1
VERIFY_TLS=0

FINERACT_USER=mifos
FINERACT_PASSWORD=password
FINERACT_TENANT=default

# Tiền tệ: để trống = lấy currency đang enable đầu tiên
FINERACT_CURRENCY=USD
OFFICE_ID=1
# 1=Person, 2=Entity
CLIENT_LEGAL_FORM_ID=1

# Seed
TARGET_CLIENTS=1000
# = TARGET_CLIENTS → mọi khách đều có savings + số dư INITIAL_DEPOSIT
TARGET_SAVINGS=1000
TARGET_LOANS=150
SEED_BATCH=50
INITIAL_DEPOSIT=5000000
SAVINGS_PRODUCT_NAME=NPD-ECO-SAVINGS
LOAN_PRODUCT_NAME=NPD-ECO-LOAN
LOAN_PRINCIPAL=1000000

# Volume V1–V3 (cron mỗi phút — trong job sleep để ~theo giây)
VOLUME_ROUNDS=40
VOLUME_SLEEP_SEC=1.0
TRANSFER_MIN=10000
TRANSFER_MAX=200000
DEPOSIT_MIN=5000
DEPOSIT_MAX=100000
WITHDRAW_MIN=5000
WITHDRAW_MAX=80000

# BPM
BPM_ONBOARD_COUNT=3
BPM_LOAN_ORIGINATE_COUNT=2
BPM_LOAN_REPAY_COUNT=5
LOAN_REPAY_MIN=50000
LOAN_REPAY_MAX=200000

DATA_DIR=/home/sysadmin/npd-fineract-ecosystem/data
LOG_DIR=/home/sysadmin/npd-fineract-ecosystem/logs
